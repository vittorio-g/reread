\code{\link{rc_index}}, \code{\link{ensemble_score}}, and \code{\link{auto_flag}};
\code{\link{simulate_clean}} / \code{\link{inject_careless}} generate test data;
and \code{\link{benchmark_indices}} compares against other indices.
}
